# Local functions + compartmental BNGL: a rate that depends on the CONTENTS of a
# complex, not on how many receptors that complex happens to contain.
#
# Scenario: receptor R is endocytosed (PM -> EM) at base rate k_endo. If the complex
# being internalized also contains at least one ligand L, the rate is boosted by a
# factor mod_endo_lig. Requirements:
#   (1) the ligand boost is a 0/1 switch -- "L present" not "how many L's"
#   (2) the whole-complex transport rate must not scale with how many R's are in
#       the complex (a receptor dimer/cluster still moves as ONE event)
#
# %x@PM:R()  -- a SPECIES-level tag: "x" refers to the whole matched complex, with
# no specific molecule serving as an anchor. The "R()" in the pattern is only the
# rule's trigger condition ("must contain a receptor"); it plays no special role in
# resolving x. Observables called as Obs(x) inside a local function just return
# their ordinary (global) match count *for that species* -- no requirement that
# Obs's pattern start with R, or with any particular molecule type. Because the tag
# carries no molecule identity, every one of the n embeddings of "R()" in an
# n-receptor complex resolves to the exact same reference, so BNG only ever
# generates ONE reaction, at the correct rate -- automatically, not by convention.
#
# (BNGL also supports a molecule-level tag, R%x(), where x refers to one specific
# matched R instance -- useful when a rate genuinely depends on a property of one
# particular matched molecule, e.g. "how many ligands are bound directly to *this*
# receptor". That form isn't needed here, since the property of interest -- does
# the complex contain a ligand -- is a property of the whole complex, not of any
# one receptor in it.)
#
# Verified with BNG2.pl 2.9.3: a complex with 2 receptors (bridged by a ligand
# dimer) and a complex with 3 receptors (asymmetric chain, ligand on one end
# only) both generate exactly one Rule_endo reaction, at rate k_endo*mod_endo_lig,
# not 2x or 3x that.

begin model

begin parameters
  k_on          0.01     # ligand-receptor association
  k_off         1.0      # ligand-receptor dissociation
  kp_LL         0.01     # ligand dimerization (this is what lets a complex carry >1 R)
  km_LL         1.0
  k_endo        0.05     # base endocytosis rate (PM -> EM)
  mod_endo_lig  5.0      # fold-increase in endocytosis rate if >=1 L is present

  R0            100
  L0            50
end parameters

begin compartments
  EC   3   10          # extracellular volume (outermost)
  PM   2   1      EC   # plasma membrane;    outside = EC
  CP   3   1      PM   # cytoplasm;          outside = PM
  EM   2   0.1    CP   # endosomal membrane; outside = CP
  EN   3   0.05   EM   # endosome interior;  outside = EM
end compartments
  # EN is required: BNG only allows PM->EM transport if EM has an "inside"
  # volume, mirroring real endo/exocytosis topology (see Compartment::
  # separated_by_volume in Perl2/Compartment.pm).

begin molecule types
  R(l)        # receptor; l = ligand-binding site
  L(r,d)      # ligand;   r = receptor-binding site, d = ligand dimerization site
end molecule types

begin seed species
  @PM:R(l)    R0
  @EC:L(r,d)  L0
end seed species

begin observables
  # No R() anchor needed -- see header note on species-level tags.
  Molecules  Lig_local   L()

  Molecules  R_PM   R()@PM
  Molecules  R_EM   R()@EM
end observables

begin functions
  # x = the whole complex matched by %x in the rule below (species-level tag).
  # Lig_local(x) = number of L's anywhere in that complex.
  # if(...) collapses that to a 0/1-style switch, so the modifier is applied
  # once per complex, not once per bound L.
  rate_endo(x) = k_endo*if(Lig_local(x)>=1, mod_endo_lig, 1)
end functions

begin reaction rules
  # Ligand binds receptor.
  L(r) + R(l)  <->  L(r!1).R(l!1)         k_on, k_off

  # Ligand dimerizes -- this is what lets one complex bridge 2 (or more) R's,
  # e.g. R-L-L-R, so we actually have something to test "not per-R" against.
  L(d) + L(d)  <->  L(d!1).L(d!1)         kp_LL, km_LL

  # Endocytosis: transport any complex containing >=1 R from PM to EM.
  # No TotalRate: BNG rejects TotalRate combined with a local function, and it
  # isn't needed -- see header note on why a complex with several R's still
  # produces exactly one reaction at rate_endo(x), not n*rate_endo(x).
  Rule_endo: %x@PM:R() -> %x@EM:R()   rate_endo(x)
end reaction rules

end model

generate_network({overwrite=>1})
