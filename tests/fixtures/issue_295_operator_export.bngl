begin model

begin parameters
  k 1
end parameters

begin molecule types
  A()
end molecule types

begin seed species
  A() 1
end seed species

begin reaction rules
  A() -> 0 k*((1~=0)+(~k))
end reaction rules

generate_network({overwrite=>1})
writeMexfile({prefix=>"issue_295_operator_export",overwrite=>1})

end model
