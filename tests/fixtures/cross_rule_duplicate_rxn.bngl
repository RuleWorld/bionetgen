begin model

begin parameters
k     0.1   # rate constant shared by both rules
end parameters

begin molecule types
Mol(state~U~P)
end molecule types

begin species
Mol(state~U)   1000
end species

begin reaction rules

# Two distinct rules that both convert Mol(state~U) to Mol(state~P)
# with the same rate constant. Both generate the byte-identical reaction
# "1 2 k", which must be folded into a single entry (rate 2*k) in the
# generated network.
Mol(state~U) -> Mol(state~P)   k
Mol(state)   -> Mol(state~P)   k

end reaction rules

generate_network({overwrite=>1});

end model
